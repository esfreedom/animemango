# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string (Supabase project, or the local server from `npm run db:dev`).
DATABASE_URL=postgresql://postgres:password@localhost:5432/animehub
# Keep this at 1 with the local PGlite server. Production can use the default.
# DATABASE_POOL_MAX=5

# Public site URL used for metadata, sitemaps and sign-in redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (email sign-in links). Leave empty to run without sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret for the cron routes. Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# AI drafts. Leave empty to skip drafting. Drafts still need admin approval.
ANTHROPIC_API_KEY=
AI_DRAFT_MODEL=claude-sonnet-5-5

# Ads stay off until the ad network approves the site (DESIGN.md section 14).
NEXT_PUBLIC_ADS_ENABLED=false
